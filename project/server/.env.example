PORT=5000
MONGO_URI=mongodb://localhost:27017/iamnhac
JWT_SECRET=your_jwt_secret_here

# === AI AGENT (bubble chat) + MACHINE LEARNING ===
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model dùng để TRÒ CHUYỆN (chat) với người dùng. Mặc định: gemini-2.5-flash
# — model MIỄN PHÍ mạnh nhất hiện dùng ổn định được với hạn mức free-tier
# rộng rãi trên Google AI Studio (không cần bật thanh toán / thẻ tín dụng).
# Muốn đổi model (VD: khi Google ra model mới miễn phí mạnh hơn), chỉ cần
# sửa dòng dưới, KHÔNG cần sửa code. Xem model + hạn mức mới nhất tại:
# https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-2.5-flash

# Model dùng để sinh VECTOR EMBEDDING cho bước Machine Learning (so khớp bài
# hát bằng Cosine Similarity / kNN). Cũng thuộc free-tier của Google AI Studio.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
